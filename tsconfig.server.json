{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "ES2022.Error"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist/server"
  },
  "include": ["server", "shared/agentRoster.cjs"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
