{
  "name": "openclaw-pixel-agents",
  "version": "1.6.0",
  "description": "Pixel art office dashboard for OpenClaw agents",
  "private": false,
  "bin": {
    "openclaw-pixel-agents": "bin/openclaw-pixel-agents.mjs"
  },
  "files": [
    "bin/openclaw-pixel-agents.mjs",
    "dist/client/**",
    "dist/server/server/**/*.js",
    "dist/server/shared/**/*.js",
    "scripts/generate-control-key.mjs",
    "collector/README.md",
    "collector/push-pixel-agents.mjs",
    "collector/.env.collector.example",
    "collector/systemd/*",
    "docs/task-access-setup.md",
    "docs/configuration.md",
    "docs/editor.md",
    "docs/releases.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "npx tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "control:key": "node scripts/generate-control-key.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "8.3.0",
    "pino": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SweetSophia/openclaw-pixel-agents.git"
  },
  "keywords": [
    "openclaw",
    "pixel-art",
    "dashboard",
    "agents",
    "visualization"
  ]
}
