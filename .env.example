# Copy to .env and replace PIXEL_CONTROL_TOKEN with output from:
# npm run --silent control:key
# The server does not load .env automatically; see docs/task-access-setup.md.
NODE_ENV=production
PORT=3001
DATA_DIR=./data
CORS_ORIGIN=http://localhost:3001
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
PIXEL_CONTROL_TOKEN=
CONTROL_SEND_ENABLED=false
CONTROL_ALLOW_TAILNET_HTTP=false

# First pairing only: supply the credential matching your Gateway's auth mode.
# Remove it and restart the office after its scoped device token is stored.
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=
