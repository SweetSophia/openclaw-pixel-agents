# Copy to .env and replace PIXEL_CONTROL_TOKEN with output from:
# npm run --silent control:key
# The server does not load .env automatically; see docs/task-access-setup.md.
NODE_ENV=production
PORT=3001
DATA_DIR=./data
# Optional absolute path on this dashboard host; absent/zero-length keeps the built-in roster.
# A whitespace-only environment value is invalid and stops startup.
# Copy agents.example.json to a private configuration directory, edit IDs/names,
# set the path below, then restart. No rebuild is needed. Never use ~ here.
# AGENT_ROSTER_PATH=/absolute/path/to/agents.json
CORS_ORIGIN=http://localhost:3001
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
PIXEL_CONTROL_TOKEN=
CONTROL_SEND_ENABLED=false
# Independent opt-in; also requires explicit paired operator.approvals authority.
CONTROL_APPROVALS_ENABLED=false
# Separate default-off admin device; source-only until separately released.
# Read docs/schedules.md before enabling. Does not change ordinary task grants.
CONTROL_SCHEDULES_MANAGE_ENABLED=false
# Unreleased source feature: separate default-off document read/admin device.
# Read docs/agent-documents.md before enabling; never elevate ordinary grants.
CONTROL_DOCUMENTS_EDIT_ENABLED=false
CONTROL_ALLOW_TAILNET_HTTP=false

# First pairing only: supply the credential matching your Gateway's auth mode.
# Remove it and restart the office after its scoped device token is stored.
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=

# Scheduling first pairing only; never borrowed from ordinary credentials.
# Remove and restart after its separate device grant is stored.
# OPENCLAW_SCHEDULES_GATEWAY_TOKEN=
# OPENCLAW_SCHEDULES_GATEWAY_PASSWORD=

# Document editing first pairing only; never borrowed from other devices.
# Remove and restart after its independently approved grant is stored.
# OPENCLAW_DOCUMENTS_GATEWAY_TOKEN=
# OPENCLAW_DOCUMENTS_GATEWAY_PASSWORD=
